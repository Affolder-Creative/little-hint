# Only use with compose.staging.yaml. Keep actual values in Coolify/password manager.
LITTLE_HINT_STAGING_IMAGE=ghcr.io/YOUR-ACCOUNT/little-hint-staging@sha256:REPLACE_WITH_DIGEST
STAGING_APP_URL=https://littlehint-staging.example.com
# Opt in when reviewing Cloudflare analytics; keep disabled otherwise.
CLOUDFLARE_WEB_ANALYTICS=false
# Hex passwords avoid URL escaping in DATABASE_URL.
STAGING_POSTGRES_PASSWORD=
STAGING_AUTH_SECRET=
STAGING_ENCRYPTION_KEY=
STAGING_MAILPIT_UI_AUTH=
# ALLOW_SYNTHETIC_DATA is deliberately not a persistent runtime setting.

# Reuse public shop details for six hours. Set false to bypass the server cache.
PRODUCT_IMPORT_CACHE_ENABLED=true

# Empty uses the admin preference, default OFF. true/false overrides and locks the UI.
AUTO_IMPORT_PRODUCT_PHOTOS=

# Optional server override: everyone or admins. Empty keeps the Administration setting editable.
FAMILY_GROUP_CREATION=

# Optional paid AI testing. Use a key from Little Hint (Staging), never production.
# Gift discovery stays off until explicitly enabled: givers, receivers, or both.
STAGING_OPENAI_API_KEY=
STAGING_OPENAI_MODEL=gpt-6-luna
STAGING_GIFT_DISCOVERY_MODE=off
STAGING_GIFT_DISCOVERY_MODEL=gpt-6-luna
STAGING_GIFT_DISCOVERY_USER_WEEKLY_LIMIT=3
STAGING_GIFT_DISCOVERY_MONTHLY_LIMIT=20
STAGING_PAID_DAILY_LIMIT=10
