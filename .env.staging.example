# Only use with compose.staging.yaml. Keep actual values in Coolify/password manager.
LITTLE_HINT_STAGING_IMAGE=ghcr.io/YOUR-ACCOUNT/little-hint-staging@sha256:REPLACE_WITH_DIGEST
STAGING_APP_URL=https://littlehint-staging.example.com
# Opt in when reviewing Cloudflare analytics; keep disabled otherwise.
CLOUDFLARE_WEB_ANALYTICS=false
# Hex passwords avoid URL escaping in DATABASE_URL.
STAGING_POSTGRES_PASSWORD=
STAGING_AUTH_SECRET=
STAGING_ENCRYPTION_KEY=
STAGING_MAILPIT_UI_AUTH=
# ALLOW_SYNTHETIC_DATA is deliberately not a persistent runtime setting.

# Reuse public shop details for six hours. Set false to bypass the server cache.
PRODUCT_IMPORT_CACHE_ENABLED=true

# Empty uses the admin preference, default OFF. true/false overrides and locks the UI.
AUTO_IMPORT_PRODUCT_PHOTOS=

# Optional server override: everyone or admins. Empty keeps the Administration setting editable.
FAMILY_GROUP_CREATION=

# Optional paid AI testing. Use a key from Little Hint (Staging), never production.
# Gift discovery stays off until explicitly enabled: givers, receivers, or both.
STAGING_OPENAI_API_KEY=
STAGING_OPENAI_MODEL=gpt-6-luna
STAGING_GIFT_DISCOVERY_MODE=off
STAGING_GIFT_DISCOVERY_MODEL=gpt-6-luna
STAGING_GIFT_DISCOVERY_USER_WEEKLY_LIMIT=3
STAGING_GIFT_DISCOVERY_MONTHLY_LIMIT=20
# Daily request limit per paid service, shared by the AI and scraping configuration.
STAGING_PAID_DAILY_LIMIT=10

# Optional paid shop lookups. Configure only the staging provider keys you use.
# auto prefers Fish, Bee, Scrape.do, then Dog. none disables paid scraping.
STAGING_SCRAPING_PROVIDER=auto
STAGING_SCRAPINGFISH_API_KEY=
STAGING_SCRAPINGBEE_API_KEY=
STAGING_SCRAPEDO_API_KEY=
STAGING_SCRAPINGDOG_API_KEY=

# Optional JSON keyed by staging account IDs; same format as production overrides.
STAGING_GIFT_DISCOVERY_USER_OVERRIDES=

# Optional Telegram. Use a dedicated staging bot. Blank enabled flags mean off.
STAGING_TELEGRAM_ENABLED=false
STAGING_TELEGRAM_BOT_TOKEN=
STAGING_TELEGRAM_BOT_NAME=

# Optional SMS requires true and complete configuration. Use a dedicated Textbelt key.
STAGING_SMS_ENABLED=false
STAGING_SMS_PROVIDER=none
STAGING_TEXTBELT_API_KEY=
STAGING_SMS_MONTHLY_LIMIT=100
STAGING_SMS_USER_DAILY_LIMIT=2
STAGING_SMS_CREDIT_RESERVE=20
STAGING_SMS_ALLOWED_EVENTS=exchange,access
STAGING_TWILIO_ACCOUNT_SID=
STAGING_TWILIO_AUTH_TOKEN=
STAGING_TWILIO_FROM=
STAGING_TWILIO_VERIFY_SERVICE_SID=

# Blank uses Administration preferences, both default ON. true/false locks the control.
PRODUCT_IMAGE_CACHE_ENABLED=
PRODUCT_IMAGE_PREFETCH_ENABLED=

# Bright Data requires both an API key and Web Unlocker zone.
STAGING_BRIGHTDATA_API_KEY=
STAGING_BRIGHTDATA_UNLOCKER_ZONE=
