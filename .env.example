NODE_ENV=development
APP_URL=http://localhost:5173
PORT=3000
DATABASE_URL=postgres://little_hint:little_hint_dev@localhost:54329/little_hint
BETTER_AUTH_SECRET=
SETTINGS_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Example sender only. Set an alias authorized by your SMTP provider.
SMTP_FROM=Little Hint <littlehint@example.com>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SERVICE_SID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Direct import runs first; auto selects one configured provider, preferring Fish.
SCRAPING_PROVIDER=
SCRAPINGFISH_API_KEY=
SCRAPEDO_API_KEY=
SCRAPINGDOG_API_KEY=
SCRAPINGBEE_API_KEY=
PAID_DAILY_LIMIT=50
UPLOAD_DIR=.local/uploads


