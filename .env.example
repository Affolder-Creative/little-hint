NODE_ENV=development
APP_URL=http://localhost:5173
PORT=3000
DATABASE_URL=postgres://little_hint:little_hint_dev@localhost:54329/little_hint
BETTER_AUTH_SECRET=
SETTINGS_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Example sender only. Set an alias authorized by your SMTP provider.
SMTP_FROM=Little Hint <littlehint@example.com>
# Optional Telegram requires true and both bot values. Blank means off.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SERVICE_SID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Empty uses built-in defaults: givers, 3, 100, gpt-6-luna.
# off disables AI gift suggestions everywhere; givers/receivers/both enable audiences.
# All AI settings are managed here; recreate both app and worker after changes.
GIFT_DISCOVERY_MODE=
GIFT_DISCOVERY_USER_WEEKLY_LIMIT=
GIFT_DISCOVERY_MONTHLY_LIMIT=
GIFT_DISCOVERY_MODEL=
# Server-only JSON keyed by account ID. Empty means no exceptions.
# Example: '{"ACCOUNT_ID":{"weeklyLimit":"unlimited","bypassMonthlyLimit":true}}'
GIFT_DISCOVERY_USER_OVERRIDES=
# Direct import runs first; auto selects one configured provider, preferring Fish.
# none = fully manual; auto = direct extraction with configured paid fallback/AI
SCRAPING_PROVIDER=
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
SCRAPINGFISH_API_KEY=
SCRAPEDO_API_KEY=
SCRAPINGDOG_API_KEY=
SCRAPINGBEE_API_KEY=
PAID_DAILY_LIMIT=50
UPLOAD_DIR=.local/uploads


# Production backups are handled by the optional backup-sidecar service.

# Reuse public shop details for six hours. Set false to bypass the server cache.
PRODUCT_IMPORT_CACHE_ENABLED=true

# Empty uses the admin preference, default OFF. true/false overrides and locks the UI.
AUTO_IMPORT_PRODUCT_PHOTOS=

# Optional browser push. Generate once with: npx web-push generate-vapid-keys
# Keep the same pair across app/worker restarts. Never commit private keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional server override: everyone or admins. Empty keeps the Administration setting editable.
FAMILY_GROUP_CREATION=

# Optional SMS. Use a dedicated Textbelt key for this environment.
# SMS requires true AND complete provider configuration. Blank means off.
SMS_ENABLED=false
SMS_PROVIDER=none
TEXTBELT_API_KEY=
SMS_MONTHLY_LIMIT=100
SMS_USER_DAILY_LIMIT=2
SMS_CREDIT_RESERVE=20
SMS_ALLOWED_EVENTS=exchange,access

# Blank uses Administration preferences, both default ON. true/false locks the control.
PRODUCT_IMAGE_CACHE_ENABLED=
PRODUCT_IMAGE_PREFETCH_ENABLED=
