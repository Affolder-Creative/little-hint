  "narrative": {
    "northStar": "See it together",
    "overview": "This record covers the finished static marketing page in `marketing/index.html` and `marketing/style.css`. It follows the user's selected concept B in `design/marketing-concepts/b-see-it-together.png`. The application has its own root `DESIGN.md`; this document does not change that system.\n\nIvory backgrounds, sienna actions, blush sections, and Fraunces headings surround actual app captures. The approved SVG logo supplies the lettering. The marketing page stays light regardless of system theme. Product screenshots explain gift coordination, while compact feature descriptions keep the page short.",
    "keyCharacteristics": [
      "Approved logo artwork, with Fraunces for page headings.",
      "Warm, fixed light colors and restrained borders.",
      "Real app screenshots with disclosed illustrative fixtures.",
      "Compact feature rows and responsive device presentation."
    ],
    "rules": [
      {
        "name": "The Fixed Light Rule",
        "body": "Marketing retains its light palette; the application's dark theme does not propagate into this page.",
        "section": "colors"
      },
      {
        "name": "The Artwork Rule",
        "body": "Use the approved logo SVG intact; Fraunces headings do not replace its lettering.",
        "section": "typography"
      },
      {
        "name": "The Screenshot Depth Rule",
        "body": "Reserve the shared ambient shadow for framed product captures; ordinary page content stays flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve approved logo artwork and the selected concept's warm palette.",
      "Do use actual app screenshots and disclose illustrative demo data.",
      "Do keep feature copy compact and screenshot details readable at phone widths.",
      "Do preserve keyboard focus, the skip link, and reduced-motion behavior."
    ],
    "donts": [
      "Don't inherit the application's dark theme into this fixed light marketing page.",
      "Don't recreate the approved logo lettering with a font.",
      "Don't replace product captures with invented app interfaces.",
      "Don't apply device bezels or screenshot shadows to ordinary text sections."
    ]
