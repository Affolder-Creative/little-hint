      "css": ".ds-nav{display:flex;gap:32px;align-items:center;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;font-size:14px;text-decoration:none;color:var(--ink,#2b201d);text-underline-offset:5px}.ds-nav a:hover{color:var(--accent,#aa4d37);text-decoration:underline}.ds-nav a:focus-visible{outline:3px solid var(--accent,#aa4d37);outline-offset:5px;border-radius:3px}@media(max-width:600px){.ds-nav{justify-content:center;width:100%;gap:30px}.ds-nav a{font-size:13px}}"
