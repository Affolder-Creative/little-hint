      "refersTo": "button-primary",
      "description": "Marketing action link with a visible keyboard focus outline.",
      "html": "<a class=\"ds-button-primary\" href=\"#self-host\">Self-host Little Hint</a>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:13px 22px;border:1px solid transparent;border-radius:8px;font-size:15px;font-weight:600;line-height:1.4;text-decoration:none;transition:background-color 160ms ease-out;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;background:var(--accent,#aa4d37);color:var(--paper,#fffdf9);}.ds-button-primary:hover{background:var(--accent-hover,#913e2c)}.ds-button-primary:focus-visible{outline:3px solid var(--accent,#aa4d37);outline-offset:5px;border-radius:3px}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Marketing action link with a visible keyboard focus outline.",
      "html": "<a class=\"ds-button-secondary\" href=\"#self-host\">View on GitHub</a>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:13px 22px;border:1px solid transparent;border-radius:8px;font-size:15px;font-weight:600;line-height:1.4;text-decoration:none;transition:background-color 160ms ease-out;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:var(--accent,#aa4d37);background:transparent;border-color:var(--accent,#aa4d37);}.ds-button-secondary:hover{background:var(--blush,#f4e4da)}.ds-button-secondary:focus-visible{outline:3px solid var(--accent,#aa4d37);outline-offset:5px;border-radius:3px}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"
    },
