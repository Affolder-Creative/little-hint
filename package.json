{
  "name": "little-hint",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/index.js",
    "worker": "node dist/server/worker.js",
    "db:migrate": "tsx src/server/cli.ts migrate",
    "bootstrap": "tsx src/server/cli.ts bootstrap",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/server/cli.ts demo",
    "seed:staging": "tsx src/server/cli.ts seed-staging",
    "test:staging-integration": "vitest run tests/staging-seed.integration.test.ts",
    "test:compose": "node scripts/check-compose.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "licenses:check": "node scripts/licenses.mjs",
    "test:browser:ci": "node scripts/ci-browser.mjs",
    "marketing:preview": "node scripts/preview-marketing.mjs",
    "marketing:check": "node scripts/check-marketing.mjs",
    "marketing:test": "node scripts/test-marketing.mjs",
    "marketing:capture": "tsx scripts/capture-marketing.ts",
    "marketing:social": "node scripts/capture-marketing-social.mjs",
    "preview": "node scripts/preview.mjs start",
    "preview:status": "node scripts/preview.mjs status",
    "preview:logs": "node scripts/preview.mjs logs",
    "preview:stop": "node scripts/preview.mjs stop",
    "preview:reset": "node scripts/preview.mjs reset",
    "test:preview": "node --test scripts/preview.test.mjs",
    "test:preview-smoke": "node scripts/preview/smoke.mjs",
    "test:images:browser": "npm run build && node tests/image-store.browser.mjs && node --import tsx tests/image-ui.browser.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.12",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@tanstack/react-query": "^5.104.5",
    "better-auth": "^1.7.10",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ipaddr.js": "^2.5.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.61.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "undici": "^8.12.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "PolyForm-Perimeter-1.0.0"
}
