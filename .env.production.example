# Replace example.com addresses with your deployment's domain and sender alias.
# The sender domain does not need to match the app's hostname.
APP_URL=https://littlehint.example.com
APP_PORT=3000
# Allow Cloudflare's analytics beacon only when intentionally enabled at the edge.
CLOUDFLARE_WEB_ANALYTICS=false
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
SETTINGS_ENCRYPTION_KEY=
SMTP_HOST=smtp.forwardemail.net
SMTP_PORT=465
SMTP_USER=littlehint@example.com
SMTP_PASS=
SMTP_FROM=Little Hint <littlehint@example.com>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SERVICE_SID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Direct import runs first; auto selects one configured provider, preferring Fish.
SCRAPING_PROVIDER=
SCRAPINGFISH_API_KEY=
SCRAPEDO_API_KEY=
SCRAPINGDOG_API_KEY=
SCRAPINGBEE_API_KEY=
PAID_DAILY_LIMIT=50
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Enable the existing Housewatch Digital sidecar in production.
COMPOSE_PROFILES=backup
BACKUP_NAME=little-hint-production
RESTIC_KEEP_DAILY=30
RESTIC_KEEP_WEEKLY=0
RESTIC_KEEP_MONTHLY=0
BACKUP_MAX_AGE_SECONDS=93600
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Empty uses the admin preference, default OFF. true/false overrides and locks the UI.
AUTO_IMPORT_PRODUCT_PHOTOS=
